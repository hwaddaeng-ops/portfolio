# 🔒 비밀 정보 — 절대 Git에 올리지 않기
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
id_rsa
id_rsa*
id_ed25519*
*credentials*
*secret*
*.token

# 👤 개인정보 — 내 PC에만 보관
docs/*profile*

# 백업 파일
*.bak
*.bak/
.git.bak/
*.orig
*~

# 임시 파일·로그
*.tmp
*.log
npm-debug.log*

# Node 패키지 (npm install로 다시 받을 수 있음)
node_modules/

# 편집기 설정
.vscode/
.idea/
*.swp

# 시스템 잡파일
Thumbs.db
desktop.ini
.DS_Store

# Vercel 연결 정보 (vercel link가 자동으로 만듦, .env.local 키 파일은 맨 위 .env.* 규칙으로 막힘)
.vercel
